# Copy to .env and fill in. Never commit .env.
# Aura: neo4j+s://<dbid>.databases.neo4j.io   Local: bolt://localhost:7687
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_DATABASE=neo4j

# Ingest (writes). On Aura Professional this is the single instance user.
NEO4J_WRITE_USERNAME=neo4j
NEO4J_WRITE_PASSWORD=change-me

# Query path (reads). On Professional there is no RBAC, so this is the same user;
# read-only is enforced in code (see docs/PLAN.md §7.3). On Business Critical use a reader role.
NEO4J_READ_USERNAME=neo4j
NEO4J_READ_PASSWORD=change-me

# Integration tests only: a disposable database (scripts/local-neo4j.sh). Tests WIPE it.
# NEO4J_TEST_URI=bolt://localhost:7687
# NEO4J_TEST_PASSWORD=threadline-local-dev
